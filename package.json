{
  "name": "toban",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "repository": "https://github.com/hackdays-io/toban",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "biome:format": "npx biome format --write .",
    "biome:check": "npx biome check --write .",
    "frontend": "pnpm --filter frontend",
    "contract": "pnpm --filter contract",
    "document": "pnpm --filter document",
    "subgraph": "pnpm --filter subgraph",
    "identity": "pnpm --filter @toban/identity",
    "discord-bot": "pnpm --filter @toban/discord-bot",
    "mcp": "pnpm --filter @toban/mcp"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "lefthook": "^1.10.1",
    "typescript": "~5.6.3"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "sharp", "workerd"],
    "overrides": {
      "protobufjs@<6.11.6": "6.11.6",
      "proxy-addr@<2.0.8": "2.0.8",
      "tinypool@<2.1.2": "2.1.2",
      "handlebars@<4.7.10": "4.7.10",
      "tar@<7.5.19": "7.5.19",
      "websocket-driver@<0.7.5": "0.7.5",
      "shell-quote@<1.11.0": "1.11.0",
      "fast-xml-parser@>=4.1.3 <4.5.4": "4.5.4",
      "pbkdf2@<3.1.3": "3.1.3",
      "sha.js@<2.4.12": "2.4.12",
      "form-data@<2.5.4": "2.5.4",
      "ejs@<3.1.7": "3.1.7"
    }
  }
}
