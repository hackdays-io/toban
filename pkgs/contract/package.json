{
  "name": "contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hardhat": "npx hardhat",
    "setup": "npx hardhat resetContractAddressesJson",
    "clean": "npx hardhat clean",
    "compile": "npx hardhat compile",
    "sync:abis": "tsx scripts/utils/syncAbis.ts",
    "test": "npx hardhat test",
    "coverage": "npx hardhat test --coverage",
    "lint": "solhint --fix --noPrompt --save 'contracts/**/*.sol'",
    "deploy:all": "npx hardhat run scripts/deploy/create2.ts",
    "local": "npx hardhat node",
    "getBalance": "npx hardhat getBalance",
    "getChainInfo": "npx hardhat getChainInfo",
    "getContractAddress": "npx hardhat getContractAddress",
    "registerSubdomain": "npx hardhat registerSubdomain",
    "createSplit": "npx hardhat run scripts/createSplit.ts",
    "upgrade:FractionToken": "npx hardhat run scripts/upgrade/fractionToken.ts",
    "upgrade:BigBang": "npx hardhat run scripts/upgrade/bigbang.ts",
    "upgrade:ThanksTokenImpl": "npx hardhat run scripts/upgrade/thanksTokenImpl.ts",
    "bigbang": "npx hardhat bigbang",
    "getWoreTime": "npx hardhat getWoreTime",
    "mintHat": "npx hardhat mintHat",
    "batchMintHat": "npx hardhat batchMintHat"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-verify": "^3.1.5",
    "@nomicfoundation/hardhat-viem": "^3.1.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "5.0.2",
    "@openzeppelin/upgrades-core": "^1.48.0",
    "@toban/spec": "workspace:*",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/jsonfile": "^6.1.4",
    "@types/mocha": "^10.0.10",
    "chai": "^5.3.3",
    "chai-as-promised": "^8.0.2",
    "dotenv": "^16.4.5",
    "ethers": "^6.15.0",
    "hardhat": "^3.22.0",
    "jsonfile": "^6.1.0",
    "mocha": "^11.8.0",
    "solady": "^0.0.201",
    "solhint": "^5.0.4",
    "tsx": "^4.22.1",
    "typescript": "^5.6.3",
    "viem": "^2.30.5"
  }
}
