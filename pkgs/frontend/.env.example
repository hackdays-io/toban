# pkgs/frontend/.env（Sepolia）/ .env.base（Base）の雛形。
# 変数の一覧と役割は README.md の「環境変数」を参照。
#
# ⚠️ VITE_* はビルド時にクライアントへ埋め込まれ、公開されます。秘密にできる値ではありません。
#    The Graph / Alchemy のキーはドメイン allowlist で保護してください。

# --- チェーン ---------------------------------------------------------------
VITE_CHAIN_ID=11155111
VITE_ALCHEMY_KEY=

# --- コントラクト -----------------------------------------------------------
# 一次情報は pkgs/contract/outputs/contracts-<net>.json。デプロイのたびに更新すること。
VITE_BIGBANG_ADDRESS=
VITE_HATS_ADDRESS=0x3bc1A0Ad72417f2d411118085256fC53CBdDd137
VITE_FRACTION_TOKEN_ADDRESS=
VITE_SPLITS_CREATOR_ADDRESS=
VITE_SCHEDULED_DISTRIBUTOR_FACTORY_ADDRESS=

# --- インデクサー -----------------------------------------------------------
VITE_GOLDSKY_GRAPHQL_ENDPOINT=
VITE_HATS_GRAPHQL_ENDPOINT=
# Base の Hats subgraph は The Graph Gateway 経由。ドメイン allowlist を付けること。
VITE_THEGRAPH_API_KEY=

# --- ウォレット / Account Abstraction ---------------------------------------
VITE_PRIVY_APP_ID=
VITE_PIMLICO_API_KEY=

# --- ストレージ・名前解決 ---------------------------------------------------
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=
VITE_PINATA_GATEWAY_TOKEN=
VITE_NAMESTONE_API_KEY=

# --- Splits -----------------------------------------------------------------
VITE_SPLITS_API_KEY=

# --- Discord 連携（@toban/identity + @toban/discord-bot）--------------------
# いずれもネットワークごとに値が違います。未設定でもビルドは通り、該当 UI が出ないだけなので
# 抜けに気づきにくい点に注意。

# identity Worker の URL。/toban-setup のウォレット連携で使用。
#   sepolia: https://toban-identity.kawabeyuki23.workers.dev
#   base:    https://toban-identity-base.kawabeyuki23.workers.dev
VITE_IDENTITY_WORKER_URL=

# Turnkey が管理する bot の署名アドレス。
# Discord 設定画面で questAgentHat を付与する対象になるため、未設定だと画面が出ない。
#   sepolia: 0xae4E13De7C14Dff7ff296De69cADf3A7F5208461
#   base:    0xE21E99d384409e119cee731D368359BDc719a5f0
VITE_DISCORD_BOT_SIGNER_ADDRESS=

# discord-bot Worker の公開 URL。「サーバーに追加」ボタンが
# <URL>/api/install/start?treeId=... に遷移し、Worker が OAuth state を署名して
# Discord へリダイレクト → 追加後にワークスペース紐付け + コマンド登録まで自動実行。
# 未設定だと「サーバーに追加」リンクは表示されない。
#   sepolia: https://toban-discord-bot.<account>.workers.dev
#   base:    https://toban-discord-bot-base.<account>.workers.dev
VITE_BOT_WORKER_URL=
